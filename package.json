{
  "name": "android-stream-desk",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "pnpm test:qr && pnpm test:typography && pnpm test:link && pnpm test:settings",
    "test:qr": "node --experimental-strip-types src/lib/apkConnectQr.test.mjs && node --experimental-strip-types src/lib/qrDecodeRoundtrip.test.ts",
    "test:typography": "node --experimental-strip-types src/lib/typography.test.mjs",
    "test:link": "node --experimental-strip-types src/lib/linkUrl.test.ts",
    "test:settings": "node --experimental-strip-types src/stores/settings.test.mjs",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --split-per-abi --target aarch64 --target armv7",
    "android:build:arm64": "tauri android build --apk --target aarch64",
    "android:build:debug": "tauri android build --apk --debug",
    "build": "vue-tsc -b && vite build && vite build --mode client --outDir dist-client --emptyOutDir",
    "build:client": "vite build --mode client --outDir dist-client --emptyOutDir",
    "preview": "preview",
    "tauri": "tauri",
    "dev:mac": "tauri dev",
    "build:mac": "tauri build",
    "icons": "tauri icon branding/logo-source.png"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-barcode-scanner": "~2.4.5",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.34",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.109",
    "@iconify-json/material-symbols": "^1.2.73",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/json": "^2.2.477",
    "@tauri-apps/cli": "^2.2.3",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "jsqr": "^1.4.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
