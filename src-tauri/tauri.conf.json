{
  "productName": "Android Stream Desk",
  "version": "1.6.1",
  "identifier": "com.ania.android.stream.desk",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss: http: https: ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Android Stream Desk Companion",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "visible": false
      }
    ]
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://raw.githubusercontent.com/aniadev/android-stream-desk/main/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RjkzRUI3NUY4NUY4RTYKUldUbStJVmZ0ejc1RmpydUtRa2FCTjIyeFdjeHA5R2dPMFFQNjhkNjdHNHZRN2svZVhiNjFJTjYK"
    }
  }
}
