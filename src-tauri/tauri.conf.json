{
  "productName": "Android Stream Desk",
  "version": "1.0.0",
  "identifier": "com.ania.android.stream.desk",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Android Stream Desk Companion",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ]
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  }
}